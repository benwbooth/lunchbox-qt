<?xml version="1.0" encoding="utf-8"?>
<LaunchBox>
  <Settings>
    <Theme>Fixture Theme</Theme>
    <DebugLog>false</DebugLog>
    <UseStartupScreen>true</UseStartupScreen>
    <StartupTheme>Fixture Desktop Startup</StartupTheme>
    <MinimumStartupScreenDisplayTime>600</MinimumStartupScreenDisplayTime>
    <MinimumShutdownScreenDisplayTime>350</MinimumShutdownScreenDisplayTime>
    <HideMouseCursorOnStartupScreens>true</HideMouseCursorOnStartupScreens>
    <UsePauseScreen>true</UsePauseScreen>
    <PauseTheme>Fixture Desktop Pause</PauseTheme>
    <PauseScreenMuting>true</PauseScreenMuting>
    <PauseScreenFading>true</PauseScreenFading>
    <SortBy>Title</SortBy>
    <SortByDesc>false</SortByDesc>
    <ListView>false</ListView>
    <EmptyValue />
  </Settings>
  <ImageTypeSettings>
    <ImageType>Box - Front</ImageType>
    <IsDefault>true</IsDefault>
    <UseInAutoImports>true</UseInAutoImports>
  </ImageTypeSettings>
</LaunchBox>
